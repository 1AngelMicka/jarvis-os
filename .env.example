# Modèle de configuration de JARVIS 2. Copier en `.env` (jamais versionné) et remplir les mots de passe.
# Générer les valeurs : uv run --python 3.13 infra/creer_env.py   (écrit .env sans rien afficher)

# --- PostgreSQL (docker-compose.yml) ---
# Propriétaire de la base : sert UNIQUEMENT aux migrations.
POSTGRES_USER=jarvis2_proprio
POSTGRES_PASSWORD=a-remplir
POSTGRES_DB=jarvis2
# Port local (127.0.0.1 seulement) ; 5433 pour ne pas gêner un autre PostgreSQL.
JARVIS2_PG_PORT=5433
# Rôle applicatif : lecture/écriture des données, aucun droit sur la structure.
JARVIS2_APP_MOT_DE_PASSE=a-remplir

# --- Core ---
JARVIS2_HOTE=127.0.0.1
JARVIS2_PORT=8765
# Dossier des données lourdes (journaux, imports, cache des modèles). Par défaut : %LOCALAPPDATA%\JARVIS2
# (Windows) ou ~/.local/share/jarvis2. Décommenter pour le placer ailleurs (ex. un disque de données).
# JARVIS2_DOSSIER_DONNEES=
JARVIS2_NIVEAU_JOURNAL=INFO

# --- Moteurs ---
JARVIS2_MOTEUR_DEFAUT=claude_code
# CLI Claude Code (abonnement Claude) ; vide = recherche dans le PATH.
JARVIS2_CLAUDE_COMMANDE=
JARVIS2_CLAUDE_MODELE=claude-sonnet-5-5
JARVIS2_CLAUDE_EFFORT=medium
JARVIS2_OLLAMA_URL=http://127.0.0.1:11434
