# Modèle de configuration de JARVIS 2 (développement : `.env` à la racine du dépôt ; installation :
# `jarvis2.env` dans le dossier de configuration, à côté de config.toml). Tout est FACULTATIF : sans fichier,
# JARVIS 2 démarre avec SQLite sur 127.0.0.1:8765. Jamais versionné.
# PostgreSQL : générer les valeurs avec  uv run --python 3.13 infra/creer_env.py   (écrit .env sans rien afficher)

# --- Stockage ---
# sqlite (défaut, un fichier) ou postgres. Vide : postgres si JARVIS2_APP_MOT_DE_PASSE est rempli, sinon sqlite.
# JARVIS2_STOCKAGE=
# Fichier SQLite (défaut : <dossier des données>/jarvis2.db)
# JARVIS2_SQLITE=

# --- PostgreSQL (option, docker-compose.yml) ---
# Propriétaire de la base : sert UNIQUEMENT aux migrations.
POSTGRES_USER=jarvis2_proprio
POSTGRES_PASSWORD=a-remplir
POSTGRES_DB=jarvis2
# Port local (127.0.0.1 seulement) ; 5433 pour ne pas gêner un autre PostgreSQL.
JARVIS2_PG_PORT=5433
# Rôle applicatif : lecture/écriture des données, aucun droit sur la structure.
JARVIS2_APP_MOT_DE_PASSE=a-remplir

# --- Core ---
JARVIS2_HOTE=127.0.0.1
JARVIS2_PORT=8765
# Ouvrir l'interface dans le navigateur au démarrage (`jarvis2` seul le fait toujours)
# JARVIS2_OUVRIR=false
# Dossier des données lourdes (journaux, imports, cache des modèles). Par défaut : %LOCALAPPDATA%\JARVIS2
# (Windows) ou ~/.local/share/jarvis2. Décommenter pour le placer ailleurs (ex. un disque de données).
# JARVIS2_DOSSIER_DONNEES=
JARVIS2_NIVEAU_JOURNAL=INFO

# --- Moteurs ---
JARVIS2_MOTEUR_DEFAUT=claude_code
# CLI Claude Code (votre abonnement Claude) ; vide = recherche dans le PATH.
JARVIS2_CLAUDE_COMMANDE=
JARVIS2_CLAUDE_MODELE=claude-sonnet-5-5
JARVIS2_CLAUDE_EFFORT=medium
JARVIS2_OLLAMA_URL=http://127.0.0.1:11434

# --- Voix ---
# Modèle Whisper de la transcription locale : tiny, base (défaut), small (plus précis), medium…
# JARVIS2_MODELE_VOIX=base
