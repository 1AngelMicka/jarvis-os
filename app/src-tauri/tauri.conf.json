{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS 2",
  "version": "0.9.0",
  "identifier": "org.jarvis-os.jarvis",
  "build": {
    "frontendDist": "../attente"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["jarvis"] }
    },
    "updater": {
      "endpoints": ["https://github.com/1AngelMicka/jarvis-os/releases/latest/download/latest.json"],
      "pubkey": "",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "category": "Productivity",
    "shortDescription": "Assistant personnel local d'abord",
    "longDescription": "JARVIS 2 : mémoire, connecteurs d'IA, agents, voix. Cette application ouvre l'interface du Core local, installé par le script d'installation.",
    "copyright": "Copyright 2026 les contributeurs de JARVIS 2",
    "licenseFile": "../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["French"] }
    }
  }
}
